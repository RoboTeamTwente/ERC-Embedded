[platformio]
default_envs = arm_board
src_dir = .
lib_dir = lib


[extra]
common_lib_deps = https://github.com/nanopb/nanopb.git#d68cd4e954ae1d376275d9fce206d554710ca4dd

[env]
platform = ststm32
framework = stm32cube
custom_nanopb_preserve_directory_hierarchy = true

custom_nanopb_project_dir = ${{project_absolute_path}}$/ERC-Protobufs
custom_nanopb_options = 
    --error-on-unmatched

test_build_src = True
monitor_speed = 115200

PIOC_build_flags = 
    +<components/${this.__env__}/**>
    -<components/${this.__env__}/firmware/Drivers/**>
    +<components/${this.__env__}/firmware/Drivers/BSP/**>
    +<components/common/**>
    +<components/common/*/inc>
    +<components/common/*/${this.__env__}/**>
    -mthumb
    -mfpu=fpv4-sp-d16
    -mfloat-abi=softfp
    -Wl,-u,_printf_float
    -D CONFIG_LOG_LEVEL=LOG_INFO

PIOC_build_src_filter =  
    +<src/${this.__env__}/**/*.c> 
    +<components/common/*/${this.__env__}/**/*.c>
    +<components/common/*/stm/**/*.c>
    +<components/common/*/*.c>
    +<components/${this.__env__}/**>
    -<components/${this.__env__}/firmware/Drivers/*>
    +<components/${this.__env__}/firmware/Drivers/BSP/**>



[env:network_board]
board = nucleo_h753zi
custom_nanopb_protos = +<components/**/*.proto>
board_build.stm32cube.custom_config_header = yes
board_build.ldscript = components/${this.__env__}/STM32H753XX_FLASH.ld
build_src_filter = 
    ${{PIOC_build_src_filter}} 
    -<components/${this.__env__}/*/test/*>

lib_deps = ${extra.common_lib_deps}
build_flags=
    +<test/common/networking/**>
    ${{PIOC_build_flags}}   

[env:sensor_board]
board = nucleo_h753zi
board_build.stm32cube.custom_config_header = yes
board_build.ldscript = components/${this.__env__}/STM32H753XX_FLASH.ld
lib_deps = ${extra.common_lib_deps}
test_filter = sensor_board/*
build_src_filter =
    PIOC_build_src_filter 
custom_nanopb_protos = +<components/**/*.proto>
build_flags = 
    PIOC_build_flags   
	  -D CONFIG_LOG_LEVEL=LOG_INFO
    -DUNITY_INCLUDE_DOUBLE
    -lm

[env:arm_board]
board = nucleo_h753zi
board_build.stm32cube.custom_config_header = yes
board_build.ldscript = components/${this.__env__}/STM32H753XX_FLASH.ld
build_src_filter = 
    PIOC_build_src_filter 
    +<components/common/motor_driver/**>
    -<components/common/motor_driver/cl3e/**>
    -<components/${this.__env__}/firmware/Middlewares/Third_Party/FreeRTOS/Source/portable/MemMang/**>
    +<components/${this.__env__}/firmware/Middlewares/Third_Party/FreeRTOS/Source/portable/MemMang/heap_4.c>
    +<erc-control-arm/control_arm_manual_ert_rtw/**>
    -<erc-control-arm/control_arm_manual_ert_rtw/ert_main.c>

custom_nanopb_protos = +<components/**/*.proto>
lib_deps = ${extra.common_lib_deps}
build_flags=
    PIOC_build_flags   
    +<components/common/motor_driver/**>
    -<components/common/motor_driver/cl3e/**>
    -I src/arm_board
    +<erc-control-arm/control_arm_manual_ert_rtw/**>

[env:driving_board]
board = nucleo_h753zi
board_build.stm32cube.custom_config_header = yes
board_build.ldscript = components/${this.__env__}/STM32H753XX_FLASH.ld
build_src_filter = 
    PIOC_build_src_filter 
    +<components/common/motor_driver/**>
custom_nanopb_protos = +<components/**/*.proto>
test_filter = driving_board/*
lib_deps = ${extra.common_lib_deps}
build_flags=
    PIOC_build_flags   
    +<components/common/motor_driver/**>
    +<components/common/stepper/driving_board/**>

[env:debugging_board]
board = nucleo_h753zi
custom_nanopb_protos = +<components/**/*.proto>
board_build.ldscript = components/${this.__env__}/STM32H753XX_FLASH.ld
build_src_filter = 
    PIOC_build_src_filter 

lib_deps = ${extra.common_lib_deps}
test_filter = common/*
build_flags=
    PIOC_build_flags   

[env:can_board]
board = nucleo_h753zi
custom_nanopb_protos = +<components/**/*.proto>
board_build.ldscript = components/can_board/firmware/STM32H753XX_FLASH.ld
build_src_filter =
    PIOC_build_src_filter 
    +<components/common/motor_driver/*/*.c>
    +<components/common/motor_driver/*/can_board/*.c>

lib_deps = ${extra.common_lib_deps}
test_filter = common/*
build_flags=
    PIOC_build_flags   
    +<components/common/motor_driver/*/*>
    +<components/common/motor_driver/*/can_board/*>

